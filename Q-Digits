#include <bits/stdc++.h>

using namespace std;

int main() {
    int t, n;
    cin >> t;
    while (t--) {
        cin >> n;
        if (n == 0) cout << "0";
        while (n != 0) {
            int r = n % 10;
            cout << r << " ";
            n /= 10;
        }
        cout << endl;
    }
    return 0;
}
