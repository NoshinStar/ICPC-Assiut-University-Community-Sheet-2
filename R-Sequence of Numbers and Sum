#include <bits/stdc++.h>

using namespace std;

int main() {
    int n, m;
    while (1) {
        cin >> n >> m;
        if (n <= 0 || m <= 0) break;
        if (n > m) {
            int temp = n;
            n = m;
            m = temp;
        }
        int sum = 0;
        for (int i = n; i <= m; i++) {
            cout << i << " ";
            sum += i;
        }
        cout << "sum =" << sum << endl;
    }
    return 0;
}
