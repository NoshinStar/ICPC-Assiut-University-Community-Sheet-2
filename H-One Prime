#include <bits/stdc++.h>

using namespace std;

int main() {
    int n, found = 1;
    cin >> n;

    for (int i = 2; i < n; i++) {
        if (n % i == 0) {
            found = 0;
        }
    }
    if (found == 1) {
        cout << "YES" << endl;
    }
    
    else cout << "NO" << endl;

    return 0;

}
