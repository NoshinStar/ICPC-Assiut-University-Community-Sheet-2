#include <bits/stdc++.h>

using namespace std;

int main() {
    int n, sum = 0;
    cin >> n;
    int temp = n;
    while (temp != 0) {
        int r = temp % 10;
        sum = sum * 10 + r;
        temp /= 10;
    }
    if (n == sum) {
        cout << sum << endl;
        cout << "YES" << endl;
    }
    else {
        cout << sum << endl;
        cout << "NO" << endl;
    }

    return 0;

}
